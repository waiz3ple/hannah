# Hannah Oyawoye portfolio — Apache config for Namecheap shared hosting

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain (www -> non-www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://hannahoyawoye.com%{REQUEST_URI} [L,R=301]

  # Single-page app: serve index.html for any route that isn't a real file or folder
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Long-term caching for hashed build assets; always revalidate the HTML
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
